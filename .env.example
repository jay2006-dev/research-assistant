# ── Asterline Research Assistant ─────────────────
# Copy this file to .env and fill in your values.
# API keys are optional during Milestone 1.

# General
DEBUG=false

# Paths (relative to project root, or absolute)
CORPUS_PATH=data/corpus.txt
CHROMA_PERSIST_DIR=data/chroma
SQLITE_URL=sqlite+aiosqlite:///data/asterline.db

# Model Provider (selection: "gemini" or "groq"; defaults to "gemini")
LLM_PROVIDER=gemini
MODEL_PROVIDER=gemini

# Primary Gemini Configuration
MODEL_NAME=gemini-3.5-flash
# Supported API key variables: GEMINI_API_KEY or API_KEY
GEMINI_API_KEY=
API_KEY=

# Alternative Groq Configuration
GROQ_API_KEY=
GROQ_MODEL_NAME=openai/gpt-oss-120b

# LangSmith (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=asterline-research-assistant
LANGSMITH_TRACING=false
